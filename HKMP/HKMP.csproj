        <SilksongRefs>C:\Program Files (x86)\Steam\steamapps\common\Hollow Knight Silksong\Hollow Knight Silksong_Data\Managed</SilksongRefs>
        <BepinRefs>C:\Program Files (x86)\Steam\steamapps\common\Hollow Knight Silksong\BepInEx</BepinRefs>
